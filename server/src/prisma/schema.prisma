generator client {
  provider = "prisma-client-js"

  // Prisma 7 requires an explicit output, and WHERE it goes matters here.
  //
  // `esbuild.config.js` globs every .ts under src/ as an entry point and
  // tsconfig includes src/**/*, so generating anywhere under src/ would pull
  // thousands of generated files into both the build and the typecheck. This
  // path resolves to server/generated/prisma — one level under the workspace
  // root, which is deliberate: src/lib/*.ts and dist/lib/*.js are both two
  // levels deep, so the same relative import works before and after the build.
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The connection URL moved to prisma.config.ts in Prisma 7 — the schema is no
  // longer allowed to carry it. The runtime client gets its connection from a
  // driver adapter instead (see lib/prisma.ts).
}

// ─── PHASE 1 MODELS ────────────────────────────────

model Task {
  id             String       @id @default(uuid())
  title          String       @db.VarChar(255)
  description    String?      @db.Text
  status         String       @default("TODO") @db.VarChar(100)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?    @map("due_date")
  position       Int          @default(0)
  estimatedMinutes Int?       @map("estimated_minutes")
  customerId     String?      @map("customer_id")
  assignedToId   String?      @map("assigned_to_id")
  /// The task this one is a subtask of. Two levels only: a subtask cannot
  /// have subtasks of its own, and a parent cannot itself be a subtask —
  /// enforced in `taskService`, not here.
  parentId       String?      @map("parent_id")
  /// An RFC 5545 RRULE line ("RRULE:FREQ=WEEKLY;BYDAY=MO"). When this task
  /// reaches a terminal status the next occurrence is created from it, with
  /// the due date advanced by the rule. Requires a due date.
  recurrence     String?      @db.VarChar(255)
  /// The occurrence created when this one was finished. Set once, so
  /// reopening and finishing again does not spawn a second.
  recurrenceNextId String?    @unique @map("recurrence_next_id")
  userId         String       @map("user_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  labels     TaskLabel[]
  mailToTask MailToTask?
  shares     TaskShare[]
  checklist  TaskChecklistItem[]
  comments   TaskComment[]
  /// Dependencies this task is the blocker of (it must finish first).
  blocks     TaskDependency[]    @relation("TaskBlocks")
  /// Dependencies this task is blocked by.
  blockedBy  TaskDependency[]    @relation("TaskBlockedBy")
  recurrenceNext     Task?  @relation("TaskRecurrence", fields: [recurrenceNextId], references: [id], onDelete: SetNull)
  recurrencePrevious Task?  @relation("TaskRecurrence")
  parent     Task?        @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks   Task[]       @relation("TaskSubtasks")
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo User?        @relation("TaskAssignments", fields: [assignedToId], references: [id], onDelete: SetNull)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([customerId])
  @@index([userId])
  @@index([assignedToId])
  @@index([parentId])
  @@map("tasks")
}

/// "blocker must finish before blocked can". Both rows belong to the same
/// account and the graph is kept acyclic — enforced in `taskService`.
model TaskDependency {
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker Task @relation("TaskBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Task @relation("TaskBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("task_dependencies")
}

/// A comment on a task. `mentions` holds the ids of the users named with @ in
/// the body, as the client resolved them — the body itself is plain text.
model TaskComment {
  id        String    @id @default(uuid())
  taskId    String    @map("task_id")
  userId    String    @map("user_id")
  body      String    @db.Text
  mentions  String[]  @default([])
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Set on the first edit; the UI shows "edited" from it.
  editedAt  DateTime? @map("edited_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TaskCommentAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([userId])
  @@map("task_comments")
}

/// A line on a task's checklist — for the steps that do not deserve a task
/// of their own. Deleted with the task.
model TaskChecklistItem {
  id          String    @id @default(uuid())
  taskId      String    @map("task_id")
  text        String    @db.VarChar(500)
  isDone      Boolean   @default(false) @map("is_done")
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_checklist_items")
}

model TaskStatus {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  label     String   @db.VarChar(100)
  color     String   @default("#4589ff") @db.VarChar(7)
  position  Int      @default(0)
  /// Whether this status means the task is finished. Several may be terminal —
  /// Done, Cancelled, Shipped — which is why it is a flag and not a name.
  isTerminal Boolean @default(false) @map("is_terminal")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation("UserTaskStatuses", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("task_statuses")
}

model CompanyCategory {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  label     String   @db.VarChar(100)
  color     String   @default("#4589ff") @db.VarChar(7)
  position  Int      @default(0)
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  customers Customer[]
  user      User       @relation("UserCompanyCategories", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("company_categories")
}

model Customer {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(255)
  email      String?  @db.VarChar(255)
  phone      String?  @db.VarChar(50)
  company    String?  @db.VarChar(255)
  website    String?  @db.VarChar(255)
  domain     String?  @db.VarChar(255)
  logoUrl    String?  @map("logo_url") @db.VarChar(500)
  notes      String?  @db.Text
  categoryId String?  @map("category_id")
  isVip      Boolean  @default(false) @map("is_vip")
  isInternal Boolean  @default(false) @map("is_internal")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category       CompanyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts       Contact[]
  tasks          Task[]
  calendarEvents CalendarEventCustomer[]
  emails         Email[]
  deals          Deal[]

  @@unique([userId, domain])
  @@index([categoryId])
  @@index([userId])
  @@map("customers")
}

model Contact {
  id         String   @id @default(uuid())
  firstName  String   @db.VarChar(100) @map("first_name")
  lastName   String   @db.VarChar(100) @map("last_name")
  email      String?  @db.VarChar(255)
  phone      String?  @db.VarChar(50)
  role       String?  @db.VarChar(100)
  isVip      Boolean  @default(false) @map("is_vip")

  /// "person" | "role" | "automated" — see utils/contactKind.ts. A string rather
  /// than an enum to match how task status is modelled here, and because the
  /// vocabulary is a heuristic that will be tuned.
  kind       String   @default("person") @db.VarChar(20)

  /// "none" | "sender" | "receiver" | "both" — which way mail has ever flowed,
  /// named from the contact's side. See utils/contactEngagement.ts.
  engagement String   @default("none") @db.VarChar(20)

  customerId String   @map("customer_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  emailAliases ContactEmailAlias[]

  @@index([customerId])
  @@index([email])
  /// The contact list filters on this, so it is indexed alongside the owner.
  @@index([customerId, kind])
  @@index([customerId, engagement])
  @@map("contacts")
}

/// Addresses a contact answers to besides `Contact.email`.
///
/// A contact is joined to mail by its email *string* — there is no foreign key
/// from `emails` to `contacts`. Merging two contacts therefore destroys the
/// losing address's entire mail history unless that address is kept somewhere,
/// which is what this table is for. It holds only addresses gained through a
/// merge, so nothing else in the app has to write to it.
model ContactEmailAlias {
  id                  String   @id @default(uuid())
  contactId           String   @map("contact_id")
  email               String   @db.VarChar(255)
  /// Id of the contact row this address came from. That row is deleted by the
  /// merge, so this is a historical reference only — deliberately not a foreign key.
  mergedFromContactId String?  @map("merged_from_contact_id")
  createdAt           DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, email])
  @@index([email])
  @@map("contact_email_aliases")
}

model Label {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  color     String   @db.VarChar(7)
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  tasks TaskLabel[]
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("labels")
}

model TaskLabel {
  taskId  String @map("task_id")
  labelId String @map("label_id")

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_labels")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── AUTH MODELS ──────────────────────────────────

model User {
  id        String      @id @default(uuid())
  email     String      @unique @db.VarChar(255)
  name      String?     @db.VarChar(255)
  avatarUrl String?     @map("avatar_url") @db.VarChar(500)
  signature String?     @db.Text

  /// When the user finished (or dismissed) first-run setup. Null means the
  /// welcome and setup wizard have not been seen yet. A timestamp rather than a
  /// boolean so it is possible to tell a long-standing account from one that
  /// completed setup after a change to the flow.
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")

  /// IANA zone, e.g. "Europe/Paris". Null means UTC — see utils/timezone.ts.
  timezone   String?  @db.VarChar(64)

  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  googleAuth        GoogleAuth?
  tasks             Task[]
  customers         Customer[]
  labels            Label[]
  emails            Email[]
  calendarEvents    CalendarEvent[]
  taskStatuses      TaskStatus[]      @relation("UserTaskStatuses")
  companyCategories CompanyCategory[] @relation("UserCompanyCategories")
  dealPartners      DealPartner[]     @relation("UserDealPartners")
  deals             Deal[]
  emailSharesSent     EmailThreadShare[] @relation("EmailSharesSent")
  emailSharesReceived EmailThreadShare[] @relation("EmailSharesReceived")
  dealSharesSent      DealShare[]        @relation("DealSharesSent")
  dealSharesReceived  DealShare[]        @relation("DealSharesReceived")
  taskSharesSent      TaskShare[]        @relation("TaskSharesSent")
  taskSharesReceived  TaskShare[]        @relation("TaskSharesReceived")
  taskAssignments     Task[]             @relation("TaskAssignments")
  taskComments        TaskComment[]      @relation("TaskCommentAuthor")
  scheduledEmails     ScheduledEmail[]
  emailDrafts         EmailDraft[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  emailTemplates      EmailTemplate[]
  emailReminders      EmailReminder[]

  @@map("users")
}

// ─── PHASE 2 MODELS ────────────────────────────────

model GoogleAuth {
  id           String    @id @default(uuid())
  accessToken  String    @db.Text @map("access_token")
  refreshToken String    @db.Text @map("refresh_token")
  tokenExpiry  DateTime  @map("token_expiry")
  email        String?   @db.VarChar(255)
  scope        String?   @db.Text
  lastSyncAt   DateTime? @map("last_sync_at")
  lastMailSyncAt DateTime? @map("last_mail_sync_at")
  lastHistoryId      String?   @map("last_history_id") @db.VarChar(50)
  calendarSyncToken  String?   @map("calendar_sync_token") @db.Text

  /// Gmail message ids whose fetch failed during a sync.
  ///
  /// A failed fetch used to be swallowed and forgotten: the message was skipped,
  /// the history cursor advanced past it, and it was never seen again. Recording
  /// the ids lets each subsequent sync retry them until they land, which is the
  /// difference between a transient error costing a delay and costing a message.
  /// Capped in code so a permanently poisoned id cannot grow this without bound.
  syncFailedMessageIds String[] @map("sync_failed_message_ids")
  userId       String    @unique @map("user_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_auth")
}

model CalendarEvent {
  id            String    @id @default(uuid())
  googleEventId String?   @map("google_event_id")
  title         String    @db.VarChar(255)
  description   String?   @db.Text
  startTime     DateTime  @map("start_time")
  endTime       DateTime  @map("end_time")
  location      String?
  isAllDay       Boolean   @default(false) @map("is_all_day")
  calendarId     String?   @map("calendar_id")
  colorId        String?   @map("color_id")
  attendees      Json?     @db.JsonB
  conferenceLink    String?   @map("conference_link")
  recurringEventId  String?   @map("recurring_event_id")
  recurrence        String[]  @default([])
  // { useDefault: boolean, overrides?: [{ method: 'email' | 'popup', minutes: number }] }
  reminders         Json?     @db.JsonB
  // 'default' | 'public' | 'private' | 'confidential'
  visibility        String?   @db.VarChar(20)
  syncedAt          DateTime? @map("synced_at")
  /// Set when a local create or update has not reached Google, cleared when it
  /// does. NULL is the absence of pending intent — which is also the only
  /// honest thing to say about every row that predates this column.
  pendingSince      DateTime? @map("pending_since")
  userId        String    @map("user_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  customers CalendarEventCustomer[]
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, googleEventId])
  @@index([startTime, endTime])
  @@index([userId])
  @@map("calendar_events")
}

model CalendarEventCustomer {
  calendarEventId String @map("calendar_event_id")
  customerId      String @map("customer_id")

  calendarEvent CalendarEvent @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([calendarEventId, customerId])
  @@map("calendar_event_customers")
}

model Email {
  id             String    @id @default(uuid())
  gmailMessageId String?   @map("gmail_message_id")
  threadId       String?   @map("thread_id")
  subject        String    @db.VarChar(500)
  from           String    @db.VarChar(255)
  fromName       String?   @db.VarChar(255) @map("from_name")
  to             String[]
  cc             String[]
  bcc            String[]
  messageId      String?   @map("message_id") @db.VarChar(500)
  inReplyTo      String?   @map("in_reply_to") @db.VarChar(500)
  references     String?   @map("references") @db.Text
  snippet        String?   @db.Text
  body           String?   @db.Text
  receivedAt     DateTime  @map("received_at")
  isRead         Boolean   @default(false) @map("is_read")
  isStarred      Boolean   @default(false) @map("is_starred")
  isArchived     Boolean   @default(false) @map("is_archived")
  isTrashed      Boolean   @default(false) @map("is_trashed")
  hasAttachment  Boolean   @default(false) @map("has_attachment")
  sizeEstimate   Int?      @map("size_estimate")
  labelIds       String[]  @map("label_ids")
  syncedAt       DateTime? @map("synced_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  customerId String?   @map("customer_id")
  userId     String    @map("user_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mailToTask      MailToTask?
  attachments     EmailAttachment[]
  scheduledReplies ScheduledEmail[]

  @@unique([userId, gmailMessageId])
  @@index([receivedAt])
  @@index([threadId])
  /// Serves the dashboard's DISTINCT ON (thread_id) ... ORDER BY received_at DESC.
  @@index([userId, threadId, receivedAt(sort: Desc)])
  @@index([customerId])
  @@index([isRead])
  @@index([from])
  @@index([userId])
  @@map("emails")
}

model EmailAttachment {
  id                String @id @default(uuid())
  emailId           String @map("email_id")
  gmailAttachmentId String @map("gmail_attachment_id")
  filename          String @db.VarChar(500)
  mimeType          String @db.VarChar(255)
  size              Int

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@map("email_attachments")
}

model MailToTask {
  id             String   @id @default(uuid())
  emailId        String   @unique @map("email_id")
  taskId         String   @unique @map("task_id")
  conversionNote String?  @db.Text @map("conversion_note")
  createdAt      DateTime @default(now()) @map("created_at")

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)
  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("mail_to_tasks")
}

// ─── DEAL REGISTRATION MODELS ─────────────────────

model DealPartner {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(255)
  registrationUrl String?  @map("registration_url") @db.VarChar(500)
  logoUrl         String?  @map("logo_url") @db.VarChar(500)
  userId          String   @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  deals Deal[]
  user  User   @relation("UserDealPartners", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("deal_partners")
}

model Deal {
  id         String    @id @default(uuid())
  title      String    @db.VarChar(255)
  partnerId  String    @map("partner_id")
  customerId String?   @map("customer_id")
  products   String?   @db.Text
  status     String    @default("TO_CHALLENGE") @db.VarChar(50)
  expiryDate DateTime? @map("expiry_date")
  notes      String?   @db.Text
  userId     String    @map("user_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  partner  DealPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares   DealShare[]

  @@index([partnerId])
  @@index([customerId])
  @@index([status])
  @@index([userId])
  @@map("deals")
}

// ─── SHARING MODELS ──────────────────────────────

model EmailThreadShare {
  id               String   @id @default(uuid())
  threadId         String   @map("thread_id")
  sharedByUserId   String   @map("shared_by_user_id")
  sharedWithUserId String   @map("shared_with_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  sharedBy   User @relation("EmailSharesSent", fields: [sharedByUserId], references: [id], onDelete: Cascade)
  sharedWith User @relation("EmailSharesReceived", fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@unique([threadId, sharedWithUserId])
  @@index([sharedWithUserId])
  @@index([sharedByUserId])
  @@index([threadId])
  @@map("email_thread_shares")
}

model DealShare {
  id               String   @id @default(uuid())
  dealId           String   @map("deal_id")
  sharedByUserId   String   @map("shared_by_user_id")
  sharedWithUserId String   @map("shared_with_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  deal       Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  sharedBy   User @relation("DealSharesSent", fields: [sharedByUserId], references: [id], onDelete: Cascade)
  sharedWith User @relation("DealSharesReceived", fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@unique([dealId, sharedWithUserId])
  @@index([sharedWithUserId])
  @@index([sharedByUserId])
  @@index([dealId])
  @@map("deal_shares")
}

model TaskShare {
  id               String   @id @default(uuid())
  taskId           String   @map("task_id")
  sharedByUserId   String   @map("shared_by_user_id")
  sharedWithUserId String   @map("shared_with_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sharedBy   User @relation("TaskSharesSent", fields: [sharedByUserId], references: [id], onDelete: Cascade)
  sharedWith User @relation("TaskSharesReceived", fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@unique([taskId, sharedWithUserId])
  @@index([sharedWithUserId])
  @@index([sharedByUserId])
  @@index([taskId])
  @@map("task_shares")
}

// ─── SCHEDULED EMAILS ──────────────────────────────

model ScheduledEmail {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  status      String   @default("pending") @db.VarChar(20)
  sendAt      DateTime @map("send_at")
  mode        String   @db.VarChar(20)

  to          String[]
  cc          String[] @default([])
  bcc         String[] @default([])
  subject     String   @db.VarChar(500)
  htmlBody    String   @db.Text @map("html_body")

  attachments Json?    @default("[]")

  replyToEmailId             String?  @map("reply_to_email_id")
  forwardExistingAttachments String[] @default([]) @map("forward_existing_attachments")

  sentMessageId String? @map("sent_message_id")
  sentThreadId  String? @map("sent_thread_id")
  errorMessage  String? @map("error_message") @db.Text
  retryCount    Int     @default(0) @map("retry_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyToEmail Email? @relation(fields: [replyToEmailId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status, sendAt])
  @@map("scheduled_emails")
}

// ─── GMAIL DRAFTS ──────────────────────────────────

/**
 * A local mirror of a Gmail draft. Gmail's `users.drafts` collection is the
 * source of truth: every write (create/update/send/delete) goes to Gmail first
 * and this row is rewritten from what we just sent, and `draftService.syncDrafts`
 * reconciles the table against `drafts.list` so a draft written in the Gmail UI
 * shows up here too.
 *
 * The mirror exists so the Drafts folder renders from Postgres like every other
 * folder rather than fanning out to `drafts.get` per row on every page load.
 * `gmailMessageId` is the change detector: Gmail mints a NEW message id every
 * time a draft is edited, and `drafts.list` returns it, so a sync only has to
 * re-fetch the drafts whose message id moved.
 */
model EmailDraft {
  id             String  @id @default(uuid())
  userId         String  @map("user_id")
  gmailDraftId   String  @map("gmail_draft_id")
  gmailMessageId String? @map("gmail_message_id")
  threadId       String? @map("thread_id")

  /// The email this draft replies to. Not a relation — a draft must outlive
  /// the message it answers, so this deliberately does not cascade.
  replyToEmailId String? @map("reply_to_email_id")

  to       String[]
  cc       String[] @default([])
  bcc      String[] @default([])
  subject  String   @default("") @db.VarChar(500)
  htmlBody String   @default("") @map("html_body") @db.Text
  snippet  String?  @db.Text

  hasAttachment Boolean @default(false) @map("has_attachment")
  /// [{ filename, mimeType, size }] — enough to list a draft, not the bytes.
  attachments   Json?   @default("[]")

  /// Gmail's internalDate for the draft message: when it was last edited.
  lastEditedAt DateTime  @map("last_edited_at")
  syncedAt     DateTime? @map("synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gmailDraftId])
  @@index([userId])
  @@index([userId, lastEditedAt])
  @@map("email_drafts")
}

// ─── AUDIT LOG ──────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  action      String   @db.VarChar(50)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String?  @map("entity_id")
  details     Json?    @db.JsonB
  status      String   @default("success") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@index([userId, createdAt])
  /// Serves the per-entity timeline (a task's activity), which reads across users.
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

// ─── NOTIFICATIONS ──────────────────────────────

model Notification {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String   @db.VarChar(50)
  title       String   @db.VarChar(255)
  message     String?  @db.Text
  entityType  String?  @map("entity_type") @db.VarChar(50)
  entityId    String?  @map("entity_id")
  isRead      Boolean  @default(false) @map("is_read")
  isDismissed Boolean  @default(false) @map("is_dismissed")
  /// When it was dismissed. Null means "before this column existed", which is
  /// treated as outside the cooldown — see notificationService.
  dismissedAt DateTime? @map("dismissed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, isDismissed])
  @@index([userId, createdAt])
  /// Serves the re-raise cooldown lookup.
  @@index([userId, entityId, type, dismissedAt])
  @@map("notifications")
}

// ─── EMAIL TEMPLATES & SNIPPETS ─────────────────

/**
 * A reusable message the user can drop into compose.
 *
 * `kind` splits two genuinely different things that share one table because
 * they share one editor and one picker:
 *   - `template` — a whole message. Carries a `subject` as well as a body.
 *   - `snippet`  — a fragment (a closing line, a booking link). No subject;
 *     `subject` is forced to null for these by the validator.
 *
 * `body` is the same sanitised HTML the compose editor produces, and may
 * contain `{{variable}}` placeholders. The variable names are checked against
 * `templateService.TEMPLATE_VARIABLES` at write time, so a typo is a 400 here
 * rather than a literal `{{firstNmae}}` in a sent email.
 *
 * `usageCount` / `lastUsedAt` order the picker by what the user actually
 * reaches for — the whole point of the feature is the two or three replies
 * they send constantly, and those should not be buried alphabetically.
 */
model EmailTemplate {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  name       String    @db.VarChar(120)
  kind       String    @default("template") @db.VarChar(20)
  subject    String?   @db.VarChar(500)
  body       String    @db.Text
  usageCount Int       @default(0) @map("usage_count")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, kind])
  @@map("email_templates")
}

// ─── SNOOZE & FOLLOW-UP REMINDERS ──────────────────

/**
 * A deferred reminder attached to a Gmail *thread*.
 *
 * Two products share this one row because they share a clock and a scheduler,
 * and differ only in what firing does:
 *
 *  - `kind = "snooze"`     — hide the thread from every mail folder until
 *                            `remindAt`, then put it back, unread.
 *  - `kind = "follow_up"`  — leave the thread where it is, and remind the user
 *                            at `remindAt` *only if nobody has replied*. An
 *                            inbound message newer than `armedAt` cancels it.
 *
 * ── Why this is a separate table and not a column on Email ──
 *
 * `emailService.upsertMessage` rewrites every Email row from Gmail on each
 * 60-second sync, and the incremental label handlers rewrite `label_ids` and
 * the four boolean flags derived from them. Any snooze state stored on `emails`
 * is therefore state the sync is contractually obliged to destroy — a snooze
 * that silently un-snoozes itself a minute later.
 *
 * Sync never touches this table. It is keyed by `(user_id, thread_id)`, which
 * is a Gmail identity, not a row identity, so it also survives a message being
 * deleted and re-imported. That is the whole mechanism: the hiding lives in a
 * place the sync has no reason to write to.
 *
 * No Prisma relation to User: this model is appended in a file another change
 * owns the middle of, and a relation needs a back-reference on `model User`.
 * The consequence is that a deleted user would leave orphan reminders — there
 * is no user-deletion path in this app today. Adding
 * `emailReminders EmailReminder[]` to `User` plus the matching foreign key is
 * the correct follow-up.
 */
model EmailReminder {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  threadId String @map("thread_id")

  /// "snooze" | "follow_up"
  kind String @db.VarChar(20)
  /// "armed" | "fired" | "cancelled"
  state String @default("armed") @db.VarChar(20)

  /// When to bring the thread back / raise the reminder.
  remindAt DateTime @map("remind_at")
  /// The `receivedAt` of the newest message in the thread when the reminder was
  /// armed. A follow-up counts anything strictly newer than this, from someone
  /// other than the user, as "they replied".
  armedAt DateTime @map("armed_at")

  /// Whether any message in the thread carried Gmail's INBOX label when it was
  /// snoozed. Un-snoozing only puts INBOX back if it was there to begin with —
  /// otherwise snoozing an already-archived thread would resurrect it.
  wasInInbox Boolean @default(true) @map("was_in_inbox")

  /// Why the reminder stopped being armed: "replied" | "trashed" | "gone" |
  /// "manual" | "replaced" | "due".
  resolution String?   @db.VarChar(20)
  firedAt    DateTime? @map("fired_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Every read is user-scoped; the state filter is what makes the "which
  /// threads are hidden right now" query on the mail list cheap.
  @@index([userId, state, kind])
  /// The scheduler's claim query: armed rows whose time has come, oldest first.
  @@index([state, remindAt])
  @@map("email_reminders")
}
