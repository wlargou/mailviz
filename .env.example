# Copy to BOTH .env and server/.env — the server loads server/.env (dotenv reads
# from the working directory, and the dev script runs inside server/). A stale
# root .env is silently ignored.

# ---- Database ----
# Local dev uses host port 5435 (see docker-compose.yml).
# Railway provides this automatically when you add a PostgreSQL service.
DATABASE_URL="postgresql://mailviz:mailviz_dev@localhost:5435/mailviz_db?schema=public"

# ---- Server ----
PORT=3002
NODE_ENV=development

# ---- Client ----
# Local dev uses 5174 (see client/vite.config.ts). In production set this to
# your public domain.
CLIENT_URL=http://localhost:5174

# ---- Google OAuth (required for Gmail & Calendar) ----
# The redirect URI is bound to the BACKEND port, so changing the frontend port
# does not require a Google Cloud Console change.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3002/api/v1/auth/google/callback

# ---- Authentication ----
# Generate all three with:
#   node -e "const c=require('crypto');for(const k of ['JWT_SECRET','JWT_REFRESH_SECRET','TOKEN_ENCRYPTION_KEY'])console.log(k+'='+c.randomBytes(32).toString('hex'))"
#
# All of these have permissive dev fallbacks so the app boots without them.
# SET ALL OF THEM IN PRODUCTION.
JWT_SECRET=<random-hex-string>
JWT_REFRESH_SECRET=<random-hex-string>

# 32-byte hex. Encrypts Google OAuth tokens at rest (AES-256-GCM).
# UNSET = tokens are stored in PLAINTEXT (utils/encryption.ts falls back silently).
TOKEN_ENCRYPTION_KEY=<random-32-byte-hex-string>

# Comma-separated login whitelist. Empty = open access.
ALLOWED_EMAILS=

# ---- Sync ----
SYNC_INTERVAL_SECONDS=60
EMAIL_SYNC_ENABLED=true
CALENDAR_SYNC_ENABLED=true
CALENDAR_SYNC_INTERVAL_SECONDS=120
